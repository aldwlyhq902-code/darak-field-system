APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Generate with: php artisan darak:web-push-keys
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
SALES_STALE_AFTER_DAYS=7

APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_CHANNEL=daily and LOG_LEVEL=warning (or stricter).

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Production PostgreSQL/Supabase must use require or verify-full.
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Device bearer tokens expire after 30 days and are renewed by signing in.
SANCTUM_EXPIRATION=43200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Darak ---
# E-invoicing is bought, never built. Supported values:
#   fake   - deterministic test double (development/tests only; never production)
#   manual - documents are issued in the accountant's ZATCA-compliant tool and the
#            finance team records number/date/QR on the panel invoices page
# Any other value is refused when the provider is resolved.
DARAK_INVOICE_PROVIDER=fake
# The SLA countdown runs only inside this window; time outside it is frozen.
DARAK_SERVICE_START=07:00:00
DARAK_SERVICE_END=23:00:00
# A repeat on the same asset inside this window is auto-flagged as rework.
DARAK_REWORK_WINDOW_DAYS=30
# Maximum bytes accepted for one photo/signature (25 MiB).
DARAK_MAX_MEDIA_BYTES=26214400
# Required in production. Use a long random secret kept outside the repository.
DARAK_BACKUP_PASSWORD=
# Keep production backups outside the deployment directory.
DARAK_BACKUP_PATH=
# Optional absolute path when pg_dump is not available on PATH.
DARAK_PG_DUMP_PATH=
# Local zero-cost health checks (scheduler/database/disk/backup).
DARAK_SCHEDULER_MAX_AGE_SECONDS=300
DARAK_BACKUP_GRACE_HOURS=2
DARAK_MINIMUM_FREE_DISK_BYTES=1073741824
# Required by production preflight after formal approval. No defaults are assumed.
DARAK_PRIVACY_CONTROLLER_NAME=
DARAK_PRIVACY_REQUEST_CHANNEL=
DARAK_PRIVACY_PROVIDERS_REGISTER=
DARAK_PRIVACY_REQUEST_PROCEDURE=
DARAK_PRIVACY_NOTICE_VERSION=
DARAK_PRIVACY_EMERGENCY_CONSENT_VERSION=
DARAK_RETENTION_VISIT_PHOTOS_DAYS=
DARAK_RETENTION_EMERGENCY_REPORTS_DAYS=
DARAK_RETENTION_SIGNATURES_REPORTS_DAYS=
DARAK_RETENTION_CAPTURE_COORDINATES_DAYS=
DARAK_RETENTION_AUDIT_LOGS_DAYS=
DARAK_RETENTION_BACKUPS_DAYS=
# Demo-only escape hatch for api/index.php on Vercel. Never set in production.
DARAK_VERCEL_EPHEMERAL_DEMO=false
# Live traffic routing. Keep "local" until a Mapbox token is configured.
DARAK_ROUTING_PROVIDER=local
DARAK_MAPBOX_TOKEN=
DARAK_DEFAULT_TRAVEL_MINUTES=30
DARAK_PREDICTION_MINIMUM_SAMPLES=500
DARAK_ENABLE_EXPERIMENTAL_ANALYTICS=false
DARAK_DEMO_PASSWORD=
# tenancy
# Quotation price control: monthly pre-VAT list price per package, an absolute
# floor, and the discount below list a non-owner may send without dual approval.
DARAK_LIST_PRICE_BASIC=
DARAK_LIST_PRICE_COMPREHENSIVE=
DARAK_QUOTATION_PRICE_FLOOR=
DARAK_QUOTATION_MAX_DISCOUNT_PERCENT=0

# auth & api
# Per-account lockout after repeated password / second-factor failures.
DARAK_PASSWORD_MAX_ATTEMPTS=5
DARAK_PASSWORD_LOCKOUT_MINUTES=15
DARAK_MFA_MAX_ATTEMPTS=5
DARAK_MFA_LOCKOUT_MINUTES=15
# API tokens unused for this many days are rejected with 401.
DARAK_TOKEN_IDLE_DAYS=14
# A new MFA secret is shown only after a password check this recent (seconds).
DARAK_PASSWORD_CONFIRM_SECONDS=600
# Evidence photos above these dimensions are refused (IMAGE_TOO_LARGE).
DARAK_MAX_IMAGE_PIXELS=40000000
DARAK_MAX_IMAGE_SIDE=12000
# POST /sync/events requests allowed per device token per minute.
DARAK_SYNC_EVENTS_PER_MINUTE=120
# Remembered Idempotency-Key responses expire after this many hours.
DARAK_IDEMPOTENCY_TTL_HOURS=48
# Oldest technician app build still served (e.g. 0.3.1 or 0.3.1+4). Empty = off.
# Older phones get 426 APP_UPDATE_REQUIRED and keep their unsynced work.
DARAK_MIN_APP_VERSION=
# Public QR emergency reports accepted per site (rolling hour / 24 h).
DARAK_EMERGENCY_REPORTS_PER_SITE_HOURLY=10
DARAK_EMERGENCY_REPORTS_PER_SITE_DAILY=30


# --- ops ---
# Audit chain key (HMAC-SHA256). Required by production preflight. Generate once
# with `openssl rand -hex 32`, keep it in the secrets manager, never rotate it.
DARAK_AUDIT_HMAC_KEY=
# Keep false: audit rows store a /24 (IPv4) or /48 (IPv6) network and a hashed
# user agent. true stores full values in immutable rows forever.
DARAK_AUDIT_KEEP_FULL_IP=false
# Backup rotation after each verified nightly backup (newest per day/week/month).
DARAK_BACKUP_KEEP_DAILY=7
DARAK_BACKUP_KEEP_WEEKLY=4
DARAK_BACKUP_KEEP_MONTHLY=6
# Off-site copy with rclone after each verified backup, e.g. offsite:darak-backups/prod
# (configure the remote once with `rclone config` as the cron user).
DARAK_BACKUP_RCLONE_REMOTE=
DARAK_RCLONE_PATH=rclone
DARAK_RCLONE_TIMEOUT_SECONDS=3600
# Dead-man's-switch pings (healthchecks.io / UptimeRobot heartbeat URLs).
DARAK_HEARTBEAT_URL=
DARAK_BACKUP_HEARTBEAT_URL=
# Critical errors to a Slack-compatible webhook (Discord: append /slack).
# Requires LOG_CHANNEL=stack; the channel joins the stack only when set.
LOG_ALERT_WEBHOOK_URL=
LOG_ALERT_LEVEL=critical
# darak:retention-purge is a dry-run report until this is true (after the owner
# and privacy adviser approve DARAK_RETENTION_*_DAYS). true also schedules it nightly.
DARAK_RETENTION_PURGE_ENABLED=false
# Freeze the scheduled jobs of non-MVP modules (routes/screens unaffected).
DARAK_MODULE_SALES=true
DARAK_MODULE_COMMISSIONS=true
DARAK_MODULE_PROCUREMENT_AUTOMATION=true
DARAK_MODULE_AUTO_REASSIGN=true
DARAK_MODULE_FLEET_HR_ALERTS=true
# Client-portal map while the technician is en route (~100 m precision).
# https XYZ template with {z}/{x}/{y}, or "none" for a text-only ETA with no
# third-party request. OpenStreetMap is a cross-border recipient.
DARAK_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
DARAK_MAP_ATTRIBUTION="© OpenStreetMap contributors"
# Reverse proxies whose X-Forwarded-* headers are trusted. Read from the PROCESS
# environment (php-fpm pool `env[TRUSTED_PROXIES]`), not from this file: proxies
# are configured before .env is loaded. Default 127.0.0.1,::1 (Nginx on the host).
# TRUSTED_PROXIES=127.0.0.1,::1

# --- data ---
# Private files disk (documents, photos, evidence, reports). "local" keeps them in
# storage/app/private. For an S3-compatible bucket set DARAK_FILES_DISK=s3, run
# `composer require league/flysystem-aws-s3-v3`, fill AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION, AWS_BUCKET (plus AWS_ENDPOINT and
# AWS_USE_PATH_STYLE_ENDPOINT=true for non-AWS providers) and block public access
# on the bucket. Switching disks does not migrate files already stored.
DARAK_FILES_DISK=local
# Commissions: accrued at collection, earned after this window unless the receipt
# is refunded / contract cancelled; paid only via an owner-recorded payout.
DARAK_COMMISSION_CLAWBACK_DAYS=30
